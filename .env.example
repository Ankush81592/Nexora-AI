# GEMINI_API_KEY: Primary provider for NEXORA AI (text, reasoning, multimodal analysis)
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# Optional Alternative Providers (supported by provider abstraction architecture)
OPENAI_API_KEY=""
ANTHROPIC_API_KEY=""
IMAGE_API_KEY=""
VIDEO_API_KEY=""
SEARCH_API_KEY=""
ELEVENLABS_API_KEY=""

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
APP_URL="MY_APP_URL"
PORT="3000"

